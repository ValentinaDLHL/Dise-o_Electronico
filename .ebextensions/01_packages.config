packages:
  yum:
    gcc: []                 # compilador C
    postgresql-devel: []    # headers de PostgreSQL
    python3-devel: []       # headers de Python
    libffi-devel: []        # necesario para algunas dependencias de C

commands:
  01_upgrade_pip:
    command: "pip3 install --upgrade pip"

container_commands:
  01_install_python_packages:
    command: "pip3 install -r requirements.txt"
