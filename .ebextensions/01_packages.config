# .ebextensions/01_packages.config
packages:
  yum:
    gcc: []
    python3-devel: []
    libffi-devel: []
    postgresql-libs: []
    make: []

container_commands:
  01_upgrade_pip:
    command: "python3 -m pip install --upgrade pip"
  02_install_requirements:
    command: "pip3 install --no-cache-dir -r requirements.txt"
